{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n FRONT,BACK -c blue,green \"npm run frontend\" \"npm run backend\"",
    "frontend": "vite --host 0.0.0.0",
    "backend": "cd ../ && bash -c '. ./scripts/load-supabase-env.sh && mvn spring-boot:run'",
    "prod": "concurrently -n FRONT,BACK -c blue,green \"npm run frontend:prod\" \"npm run backend:prod\"",
    "frontend:prod": "vite preview --host 0.0.0.0 --port 4173",
    "backend:prod": "cd ../ && bash -c '. ./scripts/load-supabase-env.sh && exec java -jar target/sucre-store-api-0.0.1-SNAPSHOT.jar'",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "@tanstack/react-query": "^5.95.2",
    "axios": "^1.13.5",
    "clsx": "^2.1.1",
    "event-source-polyfill": "^1.0.31",
    "framer-motion": "^12.33.0",
    "lucide-react": "^0.563.0",
    "prop-types": "^15.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.13.0",
    "react-toastify": "^11.0.5",
    "tesseract.js": "^6.0.1",
    "tailwind-merge": "^3.4.0",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^4.0.0",
    "vite": "^5.4.19"
  }
}
